<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>foxglove_bridge</name>
  <version>3.4.1</version>
  <description>
    ROS 1 Foxglove bridge: connects ROS 1 topics, services, and parameters
    to Foxglove clients over a local WebSocket server and, when enabled,
    the Foxglove remote access gateway.
  </description>
  <maintainer email="ros-tooling@foxglove.dev">Foxglove</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/foxglove/foxglove-bridge-ros1</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>resource_retriever</depend>
  <depend>roscpp</depend>
  <depend>rosgraph_msgs</depend>
  <depend>topic_tools</depend>
  <depend>ros_babel_fish</depend>

  <test_depend>rostest</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>nlohmann-json-dev</test_depend>
  <test_depend>websocketpp</test_depend>
  <test_depend>asio</test_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
